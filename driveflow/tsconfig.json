{
  "compilerOptions": {

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "nodenext",
    "target": "esnext",
    "types": [],

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    
    // ДОБАВЬТЕ ИЛИ РАСКОММЕНТИРУЙТЕ ЭТИ ДВЕ СТРОЧКИ:
    "outDir": "./dist",       /* Указывает, куда складывать скомпилированный JS код */
    "rootDir": "./src"        /* Указывает, где лежат исходные файлы TypeScript */
  },
  "include": ["src/**/*"]
}
